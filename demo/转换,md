#### 5. 虚拟 UI 交互与轻量级补间动画系统（取代 DOM Click 与 CSS 动画）

微信小游戏没有 HTML 按钮和模态弹窗，全部交互统一通过 Canvas 上的 **虚拟包围盒（HitBox）检测** 实现：

```javascript
// InteractionManager.js
class HitBoxManager {
  constructor() {
    this.boxes = [];
  }

  clear() {
    this.boxes.length = 0;
  }

  add(id, x, y, w, h, onClick) {
    this.boxes.push({ id, x, y, w, h, onClick });
  }

  dispatch(touchX, touchY) {
    // 从顶层到底层倒序判定
    for (let i = this.boxes.length - 1; i >= 0; i--) {
      const b = this.boxes[i];
      if (touchX >= b.x && touchX <= b.x + b.w && touchY >= b.y && touchY <= b.y + b.h) {
        b.onClick();
        return true;
      }
    }
    return false;
  }
}

```

