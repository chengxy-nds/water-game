#### 2. 静态纹理预烘焙技术（彻底解决卡顿与 SVG 滤镜丢失）

**核心原则**：所有瓶身外壳、粗麻布软垫、底栏超椭圆玻璃按钮，**只在游戏启动时渲染一次到离屏 Canvas，进入主循环后 100% 使用 `ctx.drawImage**`。

```javascript
// TextureManager.js
class TextureAtlas {
  constructor() {
    this.cache = new Map();
  }

  // 初始化时预先烘焙静态底座与按钮
  initPrebake() {
    this.bakeCoaster('coaster_normal', false);
    this.bakeCoaster('coaster_dark', true);
    this.bakeGlassRim();
  }

  // 烘焙 3D 粗麻布软垫到离屏缓冲 (一次性渲染，零运行时开销)
  bakeCoaster(key, isDark) {
    const offCanvas = Platform.createCanvas(200, 92);
    const ctx = offCanvas.getContext('2d');
    
    // 1. 地面暖色投影
    const shadowGrad = ctx.createRadialGradient(84, 68, 5, 84, 68, 90);
    shadowGrad.addColorStop(0, 'rgba(148, 62, 14, 0.62)');
    shadowGrad.addColorStop(1, 'rgba(185, 92, 28, 0)');
    ctx.fillStyle = shadowGrad;
    ctx.beginPath();
    ctx.ellipse(84, 68, 90, 23, -0.08, 0, Math.PI * 2);
    ctx.fill();

    // 2. 软垫立体侧壁
    const sideGrad = ctx.createLinearGradient(0, 20, 0, 79);
    sideGrad.addColorStop(0, isDark ? '#69523a' : '#c4945a');
    sideGrad.addColorStop(1, isDark ? '#1a110a' : '#331f0c');
    ctx.fillStyle = sideGrad;
    ctx.beginPath();
    ctx.moveTo(22, 39);
    ctx.bezierCurveTo(22, 26, 50, 20, 100, 20);
    ctx.bezierCurveTo(150, 20, 178, 26, 178, 39);
    ctx.lineTo(175, 55);
    ctx.bezierCurveTo(172, 71, 144, 79, 100, 79);
    ctx.bezierCurveTo(56, 79, 28, 71, 25, 55);
    ctx.closePath();
    ctx.fill();

    // 3. 软垫饱满顶面
    const topGrad = ctx.createLinearGradient(24, 15, 176, 62);
    topGrad.addColorStop(0, '#fff8e6');
    topGrad.addColorStop(0.5, isDark ? '#634d36' : '#d9b077');
    topGrad.addColorStop(1, '#38220c');
    ctx.fillStyle = topGrad;
    ctx.beginPath();
    ctx.ellipse(100, 38, 78, 23, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = isDark ? 'rgba(255,232,185,0.35)' : 'rgba(255,248,225,0.7)';
    ctx.lineWidth = 2;
    ctx.stroke();

    this.cache.set(key, offCanvas);
  }

  get(key) {
    return this.cache.get(key);
  }
}

```

