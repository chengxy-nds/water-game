### 三、 关键模块重构与高性能代码实现

#### 1. 跨平台适配层（抹平 微信 / 抖音 / TapTap / Web）

彻底移除全局 `document` 依赖，使用适配器模式统一入口：

```javascript
// PlatformAdapter.js
const Platform = {
  isWechat: typeof wx !== 'undefined' && !!wx.getSystemInfoSync,
  isDouyin: typeof tt !== 'undefined',
  
  createCanvas(width, height) {
    if (this.isWechat) return wx.createOffscreenCanvas({ type: '2d', width, height });
    if (this.isDouyin) return tt.createOffscreenCanvas({ type: '2d', width, height });
    const c = document.createElement('canvas');
    c.width = width; c.height = height;
    return c;
  },

  getScreenSize() {
    if (this.isWechat) {
      const info = wx.getSystemInfoSync();
      return { width: info.windowWidth, height: info.windowHeight, dpr: info.pixelRatio };
    }
    if (this.isDouyin) {
      const info = tt.getSystemInfoSync();
      return { width: info.windowWidth, height: info.windowHeight, dpr: info.pixelRatio };
    }
    return { width: window.innerWidth, height: window.innerHeight, dpr: window.devicePixelRatio || 1 };
  }
};

```

