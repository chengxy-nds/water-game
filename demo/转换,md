#### 4. 高保真水柱流体与对象池粒子（Zero Allocation / 0 内存抖动）

倒水过程中的水花飞溅、气泡冒泡采用**对象池（Object Pool）**，杜绝每帧 `new` 粒子带来的卡顿：

```javascript
// StreamAndParticleSystem.js
class ParticlePool {
  constructor(size = 60) {
    this.pool = Array.from({ length: size }, () => ({
      active: false, x: 0, y: 0, vx: 0, vy: 0, r: 0, color: '', alpha: 1
    }));
  }

  spawn(x, y, vx, vy, r, color) {
    const p = this.pool.find(item => !item.active);
    if (!p) return;
    p.active = true; p.x = x; p.y = y; p.vx = vx; p.vy = vy; p.r = r; p.color = color; p.alpha = 1;
  }

  updateAndDraw(ctx, dt) {
    for (const p of this.pool) {
      if (!p.active) continue;
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      p.vy += 450 * dt; // 真实重力加速度
      p.alpha -= 1.8 * dt;

      if (p.alpha <= 0) {
        p.active = false;
        continue;
      }

      ctx.save();
      ctx.globalAlpha = p.alpha;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
  }
}

// 倾倒重力动态水柱绘制函数
function drawLiveStream(ctx, spoutX, spoutY, targetX, targetY, color, flowProgress) {
  if (flowProgress <= 0) return;

  ctx.save();
  const grad = ctx.createLinearGradient(spoutX, spoutY, targetX, targetY);
  grad.addColorStop(0, color.highlight);
  grad.addColorStop(0.5, color.mid);
  grad.addColorStop(1, color.right);

  const midY = (spoutY + targetY) * 0.5 - 18; // 重力下垂自然弧线
  ctx.strokeStyle = grad;
  ctx.lineWidth = 6 * Math.sin(flowProgress * Math.PI); // 倒水过程由细到粗再收尾
  ctx.lineCap = 'round';

  ctx.beginPath();
  ctx.moveTo(spoutX, spoutY);
  ctx.quadraticCurveTo((spoutX + targetX) * 0.5, midY, targetX, targetY);
  ctx.stroke();

  // 中心高光细线
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)';
  ctx.lineWidth = 1.8;
  ctx.stroke();
  ctx.restore();
}

```

